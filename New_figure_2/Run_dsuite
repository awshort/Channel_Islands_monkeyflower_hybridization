#Commands used to run dsuite
#Exclude individuals identified as hybrids in admixture analysis
vcftools --vcf 'biallelic.phased.selected.filtered.postBQSR.v1.UnifiedGenotyper.channel_islands.recode.vcf' --keep iqtree_keep_admixture_scores_greater_than_0.99.csv --recode --out iqtree_keep_admixture_scores_greater_than_0.99.biallelic.phased.selected.filtered.postBQSR.v1.UnifiedGenotyper.channel_islands
#Run dtrios command from dsuite
'Dsuite' Dtrios "iqtree_keep_admixture_scores_greater_than_0.99.biallelic.phased.selected.filtered.postBQSR.v1.UnifiedGenotyper.channel_islands.recode.vcf" 'iqtree_keep_admixture_scores_greater_than_0.99_labels.csv' -t 'tree_2.newick' -o channel_islands_2
#Generate fbranch results using dsuite
'Dsuite' Fbranch 'Fbranch.tree_2.newick' 'channel_islands_2_tree.txt' > Fbranch.channel_islands_2.txt
#Use dtools python script to plot fbranch results
python 'Dsuite/utils/dtools.py' 'Fbranch.channel_islands_2.txt' 'Fbranch.tree_2.newick' --outgroup Outgroup


