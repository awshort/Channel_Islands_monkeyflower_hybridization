#R commands to plot admixture results
#Prepare labels file to order admixture plot
```{r}
# Read in labels file
labels<-read.table('admixture_parv_lon_labels.csv',sep=" ", fill=TRUE)

# Name the columns
names(labels)<-c("ind","pop")

# Add a column with population indices to order the barplots
# Use the order of populations provided as the fourth argument (list separated by commas)
labels$n<-factor(labels$pop,levels=unlist(strsplit(c("parviflorus","admixed","longiflorus_island","longiflorus"),",")))
levels(labels$n)<-c(1:length(levels(labels$n)))
labels$n<-as.integer(as.character(labels$n))
```
#Plot admixture results for K=2
```{r)
# read in the different admixture output files
tbl<-read.table("no_chr.no_missing.biallelic.parv_lon.biallelic.phased.selected.filtered.postBQSR.v1.UnifiedGenotyper.channel_islands.2.Q")

# Prepare spaces to separate the populations/species
rep<-as.vector(table(labels$n))
spaces<-0
for(i in 1:length(rep)){spaces=c(spaces,rep(0,rep[i]-1),0.5)}
spaces<-spaces[-length(spaces)]
# Plot the cluster assignments as a single bar for each individual
pdf(file="K2_sorted_by_species.pdf",width = 15, height = 10)
 par(mfrow=c(1,1),mar=c(0,1,0,0),oma=c(2,1,9,1),mgp=c(0,0.2,0),xaxs="i",cex.lab=1.2,cex.axis=0.8)
 bp <- barplot(t(as.matrix(tbl[order(labels$n),])), col=c("lightpink","purple4"),xaxt="n", border=NA,space=spaces)
 axis(3,at=bp,labels=labels$ind[order(labels$n)],las=2,tick=F,cex=0.6)
 bp
 #lapply(2:(maxK-1), function(x) barplot(t(as.matrix(tbl[[x]][order(labels$n),])), col=coul,xaxt="n", border=NA,ylab=paste0("K=",x+1),yaxt="n",space=spaces))
 axis(1,at=c(which(spaces==0.5),bp[length(bp)])-diff(c(1,which(spaces==0.5),bp[length(bp)]))/2,
     labels=unlist(strsplit(c("parviflorus","admixed","longiflorus_island","longiflorus"),",")))
dev.off()
```
